<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop Hoa Tươi</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <!-- Header / Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold text-warning" href="#">Logo thương hiệu</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Search -->
            @using (Html.BeginForm("TimTheoTuKhoa", "Home", FormMethod.Get))
            {
                <div class="d-flex ms-auto flex-fill">
                    <input class="form-control me-2" type="search" name="tuKhoa" placeholder="Tìm kiếm sản phẩm..." aria-label="Search" />
                    <button class="btn btn-outline-light" type="submit">Tìm</button>
                </div>
            }
            <!-- Đăng nhập -->
            @if (Session["KhachHang"] == null)
            {
                <a href="@Url.Action("Login", "Home")" class="btn btn-primary" style="margin-left: 5px">Login</a>
            }
            else
            {
                var kh = Session["KhachHang"] as Tuan_06.Models.KhachHang;
                <div class="text-white" style="margin-left: 15px">
                    <i class="bi bi-person"></i> Chào bạn, @kh.TenKhachHang
                    <a href="@Url.Action("LichSu", "Home")" class="text-warning ms-2 text-decoration-none">Lịch sử</a>
                    <a href="@Url.Action("Logout", "Home")" class="text-danger ms-2 text-decoration-none">Thoát</a>
                </div>
            }
        </div>
    </nav>

    <div class="container mt-4">
        <div class="row">
            <!-- Menu trái -->
            <div class="col-md-3 col-lg-2">
                @Html.Action("_Category", "Home")
            </div>

            <!-- Nội dung sản phẩm -->
            <main class="col-md-9 col-lg-10">
                <h4 class="mb-3">Sản phẩm nổi bật</h4>
                @RenderBody()
            </main>
        </div>
    </div>


    <!-- Footer -->
    <footer class="bg-dark text-light mt-5 pt-4 pb-3">
        <div class="container">
            <div class="row">
                <!-- Giới thiệu -->
                <div class="col-md-4 mb-3">
                    <h5 class="fw-bold">Cửa hàng hoa tươi</h5>
                    <p>
                        Mang đến những bó hoa tươi đẹp, sang trọng và ý nghĩa cho mọi dịp.
                        Dịch vụ giao hoa nhanh chóng và tận tâm.
                    </p>
                </div>

                <!-- Liên kết nhanh -->
                <div class="col-md-4 mb-3">
                    <h5 class="fw-bold">Liên kết nhanh</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-light text-decoration-none">Trang chủ</a></li>
                        <li><a href="#" class="text-light text-decoration-none">Sản phẩm</a></li>
                        <li><a href="#" class="text-light text-decoration-none">Giỏ hàng</a></li>
                        <li><a href="#" class="text-light text-decoration-none">Liên hệ</a></li>
                    </ul>
                </div>

                <!-- Liên hệ -->
                <div class="col-md-4 mb-3">
                    <h5 class="fw-bold">Liên hệ</h5>
                    <p><i class="bi bi-geo-alt"></i> 123 Đường Hoa Tươi, TP.HCM</p>
                    <p><i class="bi bi-telephone"></i> 0909 123 456</p>
                    <p><i class="bi bi-envelope"></i> contact@hoatuoi.com</p>
                </div>
            </div>
            <hr class="border-secondary">
            <div class="text-center">
                <small>&copy; 2026 Cửa hàng hoa tươi. All rights reserved.</small>
                <p>&copy; @DateTime.Now.Year - My ASP.NET Application</p>
            </div>
        </div>
    </footer>



    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
