@model List<LTWeb_Tuan10.tblSach>

<main class="col-md-9 col-lg-10">
    <h4 class="mb-3">Sản phẩm nổi bật</h4>
    @if(ViewBag.Found != null)
    {
        <b class="text-muted">Tìm thấy sản phẩm thuộc: @ViewBag.Found</b>
    }
    <div class="row">
        @foreach (var Sach in Model)
        {
            <div class="col-md-4 col-lg-3 mb-4">
                <div class="card h-100 shadow-sm">
                    <img src="~/Content/Images/@Sach.AnhBia" class="card-img-top" alt="@Sach.TenSach">
                    <div class="card-body d-flex flex-column text-center">
                        <h6 class="card-title text-truncate">@Sach.TenSach</h6>
                        <p class="text-danger fw-bold mt-auto">@String.Format("{0:N0} đ", Sach.GiaBan)</p>
                        <a href="@Url.Action("Details", "Sach", new { id = Sach.MaSach })" class="btn btn-sm btn-outline-primary">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>
</main>