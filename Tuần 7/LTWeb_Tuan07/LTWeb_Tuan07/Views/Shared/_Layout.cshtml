<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trippy - Quản lý Tour</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
    <style>
        .header-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
        }
        .header-top img.logo {
            height: 40px;
        }
        .header-nav a {
            color: #28a745;
            text-decoration: none;
            margin: 0 15px;
            font-weight: bold;
        }
        .navbar-green {
            background-color: #28a745;
            padding: 10px 0;
        }
        .navbar-green .form-control {
            border-radius: 0;
        }
        .navbar-green .btn-search {
            background-color: #fd7e14;
            color: white;
            border-radius: 0;
            border: none;
            padding: 6px 30px;
        }
        .sidebar-title {
            background-color: #ffc107;
            color: red;
            font-weight: bold;
            text-align: center;
            padding: 10px;
            border: 1px solid #ddd;
            margin-bottom: 0;
        }
        .sidebar-menu .list-group-item {
            border: 1px solid #ddd;
            border-top: none;
            color: #17a2b8;
            text-align: center;
        }
        .footer-green {
            background-color: #28a745;
            color: white;
            padding: 15px 0;
            margin-top: 30px;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header Top -->
        <div class="header-top">
            <div>
                <h2 style="color: #28a745; font-weight: bold; margin: 0; display: inline-block;">trippy</h2>
            </div>
            <div class="header-nav">
                <a href="@Url.Action("Index", "Tour")">Trang chủ</a>
                <a href="#">Về chúng tôi</a>
                <a href="#">Liên hệ</a>
            </div>
            <div class="text-end" style="color: #fd7e14; font-size: 0.9rem;">
                <i class="bi bi-telephone"></i> Hotline: 0911.88.33.99<br>
                Tư vấn: (028) 3838 6929
            </div>
        </div>
    </div>

    <!-- Navbar Green -->
    <div class="navbar-green">
        <div class="container d-flex justify-content-between align-items-center">
            @using (Html.BeginForm("TimKiem", "Tour", FormMethod.Get, new { @class = "d-flex", style = "width: 50%;" }))
            {
                <input class="form-control me-2" type="text" name="keyword" placeholder="Nhập tên tour...">
                <button class="btn btn-search" type="submit">TÌM KIẾM</button>
            }
            <div class="d-flex align-items-center">
                <a href="@Url.Action("TimKiemNangCao", "Tour")" class="text-white me-3 text-decoration-none"><i class="bi bi-search"></i> Tìm nâng cao</a>
                <a href="#" class="text-white fs-4 me-3"><i class="bi bi-cart"></i></a>
                @if (Session["KhachHang"] != null)
                {
                    var kh = Session["KhachHang"] as LTWeb_Tuan07.Models.KhachHang;
                    <div class="dropdown">
                        <button class="btn btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i> @kh.TenKH
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="@Url.Action("Logout", "Tour")">Đăng xuất</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a href="@Url.Action("Login", "Tour")" class="btn btn-outline-light"><i class="bi bi-person-circle"></i> Tài khoản</a>
                }
            </div>
        </div>
    </div>

    <div class="container mt-4">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3">
                <div class="sidebar-title">DANH MỤC TOUR</div>
                <div class="list-group sidebar-menu">
                    @Html.Action("_DanhMuc", "Tour")
                </div>
            </div>

            <!-- Content -->
            <div class="col-md-9">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="footer-green text-center">
        <div class="container d-flex justify-content-between">
            <span><i class="bi bi-star-fill"></i> CHẤT LƯỢNG</span>
            <span><i class="bi bi-shield-check"></i> UY TÍN</span>
            <span><i class="bi bi-currency-dollar"></i> GIÁ TỐT</span>
            <span><i class="bi bi-check-circle"></i> DỄ DÀNG</span>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
