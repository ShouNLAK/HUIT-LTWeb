@model IEnumerable<LTWeb_Tuan07.Models.Tour>

@{
    ViewBag.Title = "Danh sách Tour";
}

<div class="row">
    @foreach (var tour in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="position-relative">
                    <img src="~/Content/Images/@tour.Hinh" class="card-img-top" alt="@tour.TenTour" onerror="this.src='https://via.placeholder.com/300x200'">
                    <a href="@Url.Action("ChiTiet", "Tour", new { id = tour.MaTour })" class="position-absolute bottom-0 start-0 m-2 btn btn-sm btn-danger rounded-pill px-3">
                        <i class="bi bi-search"></i> Tiết kiệm
                    </a>
                </div>
                <div class="card-body p-2" style="font-size: 0.9rem;">
                    <p class="mb-1 text-muted">Ngày đi: @tour.NgayDi.ToString("dd/MM/yyyy")</p>
                    <p class="mb-1 text-danger fw-bold">Giá: @tour.GiaVe.ToString("N0") đ</p>
                    <p class="mb-0 text-muted">Nơi khởi hành: @tour.NoiKhoiHanh</p>
                </div>
                <div class="card-footer bg-white border-0 p-2 pt-0 text-center">
                    <h6 class="card-title fw-bold text-dark text-truncate" style="font-size: 0.95rem;">@tour.TenTour</h6>
                </div>
            </div>
        </div>
    }
</div>
