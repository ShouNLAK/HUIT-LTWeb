@model LTWeb_Tuan07.Models.Tour

@{
    ViewBag.Title = "Chi tiết tour";
}

<h4 class="text-primary fw-bold mb-3">Chi tiết dịch vụ</h4>
<h5 class="text-danger mb-3">@Model.TenTour</h5>

<div class="row mb-4">
    <div class="col-md-7">
        <img src="~/Content/Images/@Model.Hinh" class="img-fluid w-100 border p-1" alt="@Model.TenTour" onerror="this.src='https://via.placeholder.com/600x400'">
    </div>
    <div class="col-md-5">
        <div class="row mb-2">
            <div class="col-4 fw-bold">Khởi hành:</div>
            <div class="col-8">@Model.NgayDi.ToString("dd/MM/yyyy")</div>
        </div>
        <div class="row mb-2">
            <div class="col-4 fw-bold">Thời gian:</div>
            <div class="col-8">N/A</div>
        </div>
        <div class="row mb-3">
            <div class="col-4 fw-bold">Nơi khởi hành:</div>
            <div class="col-8">@Model.NoiKhoiHanh</div>
        </div>
        <h4 class="text-danger fw-bold mb-4">@Model.GiaVe.ToString("N0") đ</h4>

        <div class="card bg-light border-0">
            <div class="card-header bg-secondary text-white fw-bold border-0">
                DỊCH VỤ ĐI KÈM
            </div>
            <div class="card-body">
                <ul class="text-danger fw-bold" style="font-size: 0.9rem;">
                    @if (ViewBag.DichVu != null)
                    {
                        foreach (var dv in ViewBag.DichVu as List<LTWeb_Tuan07.Models.DichVu>)
                        {
                            <li>@dv.TenDichVu</li>
                        }
                    }
                </ul>
                <div class="text-center mt-3">
                    <button class="btn btn-danger btn-sm px-4 rounded-0"><i class="bi bi-cart"></i> Đặt ngay</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 mb-3">
    <div class="card-header bg-secondary text-white fw-bold rounded-0">
        CHƯƠNG TRÌNH TOUR
    </div>
    <div class="card-body px-0" style="font-size: 0.95rem; text-align: justify;">
        @Model.ChuongTrinhTour
    </div>
</div>

<div class="card border-0">
    <div class="card-header text-warning fw-bold bg-white border-0 px-0 fs-5">
        <i class="bi bi-star-fill"></i> CÁC NƠI THAM QUAN
    </div>
    <div class="card-body px-0">
        <ul style="font-size: 0.95rem; text-align: justify; color: #555;">
            @{
                string[] dsDiaDiem = Model.NoiThamQuan.Split(',');
                foreach (var dd in dsDiaDiem)
                {
                    <li>@dd.Trim()</li>
                }
            }
        </ul>
    </div>
</div>
