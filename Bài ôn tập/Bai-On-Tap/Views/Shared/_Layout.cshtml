<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>
<body>

    <!-- Header / Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-success">
        <div class="container">
            <a class="navbar-brand fw-bold text-light" href="#"><i class="bi bi-flower1 text-danger"></i> Shop Hoa</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link text-light" href="@Url.Action("Index", "SanPham")">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light" href="#">Liên hệ</a>
                    </li>
                </ul>
                <!-- Search -->
                @using (Html.BeginForm("TimKiem", "SanPham", FormMethod.Get, new { @class = "d-flex" }))
                {
                    <input class="form-control me-2" type="search" name="keyword" placeholder="Tìm kiếm" aria-label="Tìm kiếm" />
                    <button class="btn btn-warning btn-search" type="submit">Tìm</button>
                }
            </div>
        </div>
    </nav>

    <!-- Main Layout -->
    <div class="container mt-4">
        <div class="row">
            <!-- Menu trái -->
            <aside class="col-md-3 col-lg-3 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-success text-white fw-bold">
                        Danh mục hoa
                    </div>
                    <div class="list-group list-group-flush">
                        @Html.Action("_DanhMuc", "SanPham")
                    </div>
                </div>
            </aside>

            <!-- Nội dung sản phẩm -->
            <main class="col-md-9 col-lg-9">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-light mt-5 pt-4 pb-3">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5 class="fw-bold">Cửa hàng hoa tươi</h5>
                    <p>Chúng tôi mang đến những bó hoa tươi đẹp, sang trọng và ý nghĩa cho mọi dịp đặc biệt. Dịch vụ giao hoa nhanh chóng và chuyên nghiệp.</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h5 class="fw-bold">Liên kết nhanh</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-light text-decoration-none">Trang chủ</a></li>
                        <li><a href="#" class="text-light text-decoration-none">Liên hệ</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-3">
                    <h5 class="fw-bold">Liên hệ</h5>
                    <p>123 Đường Hoa Tươi, TP.HCM</p>
                    <p>0909 123 456</p>
                    <p>contact@hoatuoi.com</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
