@model Bai_On_Tap.Models.SanPham

<div class="container mt-4">
    <div class="row">
        <!-- Hình ảnh sản phẩm -->
        <div class="col-md-5">
            <div class="card shadow-sm border-0">
                <img src="~/Content/images/@Model.Hinh" class="card-img-top rounded" alt="@Model.TenSP">
            </div>
        </div>
        <!-- Thông tin sản phẩm -->
        <div class="col-md-7">
            <h2 class="mb-3 text-primary">@Model.TenSP</h2>
            <h4 class="text-danger fw-bold">@String.Format("{0:N0} VNĐ", Model.Gia)</h4>
            
            <p class="mt-3" style="line-height: 1.8; font-size: 1.1rem; text-align: justify;">
                @Model.MoTa
            </p>
            
            <div class="mt-4">
                <button class="btn btn-success btn-lg px-4">
                    <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                </button>
                <a href="@Url.Action("Index", "SanPham")" class="btn btn-outline-secondary btn-lg px-4 ms-2">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>
        </div>
    </div>

    <!-- Gợi ý sản phẩm liên quan -->
    @if (ViewBag.SanPhamLienQuan != null)
    {
        <div class="mt-5">
            <h4 class="mb-3">Sản phẩm liên quan</h4>
            <div class="row">
                <!-- Render danh sách sản phẩm liên quan -->
                @foreach (var sp in ViewBag.SanPhamLienQuan)
                {
                    <div class="col-md-3 mb-3">
                        <div class="card shadow-sm h-100">
                            <div class="thumb">
                                <img src="~/Content/images/@sp.Hinh" class="card-img-top" alt="@sp.TenSP" />
                            </div>
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@sp.TenSP</h5>
                                <p class="text-danger fw-bold">@sp.Gia.ToString("N0") VNĐ</p>
                                <a href="@Url.Action("ChiTiet", "SanPham", new { id=sp.MaSP })" class="btn btn-sm btn-success mt-auto btn-custom">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
