@model IEnumerable<Bai_03.Models.SanPham>

<h2>Hiển thị sản phẩm</h2>
<p>Loại : <b>@ViewBag.TenLoai</b></p>

@using (Html.BeginForm("Index", "Home", FormMethod.Get))
{
    <div style="margin-bottom: 20px;">
        <span>Choose an Category </span>
        @Html.DropDownList("MaLoai", null, "--- Tất cả ---", htmlAttributes: new { style = "padding: 3px; margin-right: 15px;" })

        <input type="text" name="SearchString" value="@ViewBag.CurrentFilter" style="padding: 2px; width: 150px;" />
        <input type="submit" value="SEARCH" style="padding: 2px 10px;" />
    </div>
}

<table class="table table-striped">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.MaSP)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TenSP)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DuongDan)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Gia)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.MoTa)
        </th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.MaSP)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TenSP)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DuongDan)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Gia)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MoTa)
            </td>
        </tr>
    }
</table>
