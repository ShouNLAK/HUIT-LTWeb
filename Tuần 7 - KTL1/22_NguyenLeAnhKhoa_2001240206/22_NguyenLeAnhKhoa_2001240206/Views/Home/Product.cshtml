@model List<_22_NguyenLeAnhKhoa_2001240206.Models.Products>

<h2 class="mb-4">Danh sách sản phẩm</h2>
<div class="row">
    @foreach (var sp in Model)
    {
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100">
                <div class="thumb">
                    <img src="~/Content/images/@sp.Avatar" class="card-img-top" style="height:185px" alt="@sp.ProductName" />
                </div>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@sp.ProductName</h5>
                    <p class="text-danger fw-bold">@sp.Price.ToString("N0") VNĐ</p>
                    <a href="@Url.Action("About","Home", new { ProductID =sp.ProductID })" class="btn btn-sm btn-warning mt-auto btn-custom">Xem chi tiết</a>
                </div>
            </div>
        </div>
    }
</div>