@model LTWeb03_Bai03.Models.Product
@using (Html.BeginForm("Add", "Home"))
            {
                <div>
                    <div>
                        @Html.Label("Tên sản phẩm : ","Name")
                        @Html.TextBoxFor(x=>x.tenSP)
