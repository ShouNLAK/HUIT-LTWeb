@model BTTL_2.Models.Product

<div class="container py-5">
    <div class="row gx-lg-5">
        @{
            <div class="col-md-5 col-lg-4 mb-4 mb-md-0">
                <div class="img-thumbnail">
                    <img src=@Model.hinhMinhHoa class="img-fluid">
                </div>
            </div>
            <div class="col-md-7 col-lg-8">
                <h1 class="card-title">@Model.tenSP</h1>
                <hr>

                <p>
                    @Model.moTa
                </p>
                <p>
                    <strong>Giá: @Model.giaBan₫</strong>
                </p>
                <div class="bg-light p-3 rounded mt-3">
                    @Html.Action("_showStar", "Product")
                </div>

            </div>
        }

    </div>
    <div>
        
    </div>

</div>