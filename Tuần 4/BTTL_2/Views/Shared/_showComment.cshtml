@model List<BTTL_2.Models.Comment>
    @{ 
        foreach (var comment in Model)
        {
        <div class="bg-white p-3 rounded shadow-sm d-flex gap-3" style="max-width: 400px; width: 100%;">

            <div class="flex-shrink-0 mt-1">
                <img class="rounded-circle object-fit-cover border" style="width: 48px; height: 48px; border-color: #dee2e6;"
                     src=@comment.anhDaiDien
                     alt="User Avatar">
            </div>

            <div class="d-flex flex-column w-100">

                <div class="d-flex align-items-baseline gap-1 mb-1">
                    <span>@comment.tenNguoiDung</span>
                    <span>@comment.ngayBinhLuan</span>
                </div>

                <p class="review-text mb-2 pe-2">
                    @comment.noiDung
                </p>

                <div class="d-flex text-warning">
                    @{
                        for (int i = 0; i < comment.soSaoDanhGia; i++)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="star-icon">
                                <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                            </svg>
                        }
                    }
                </div>
            </div>
        </div>
            }
    }
