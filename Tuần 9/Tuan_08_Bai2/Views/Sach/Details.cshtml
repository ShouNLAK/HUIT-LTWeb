@model Tuan_08_Bai2.tblSach

@{
    ViewBag.Title = "Details";
}

<h2>Details</h2>

<div>
    <h4>tblSach</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.TenSach)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TenSach)
        </dd>

        <dt>
            Hình Ảnh
        </dt>

        <dd>
            @{
                var img = Model.tblHinhAnh.FirstOrDefault();
                if (img != null && !string.IsNullOrEmpty(img.HinhAnh))
                {
                    <img src="@Url.Content(img.HinhAnh)" alt="@Model.TenSach" style="width: 150px; height: auto;" />
                }
            }
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.NamXB)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.NamXB)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.SoTrang)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.SoTrang)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.GiaBan)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.GiaBan)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.NoiDung)
        </dt>

        <dd>
            @Html.Raw(Model.NoiDung)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.tblLoaiSach.TenLoai)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.tblLoaiSach.TenLoai)
        </dd>

    </dl>
</div>
<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.MaSach }) |
