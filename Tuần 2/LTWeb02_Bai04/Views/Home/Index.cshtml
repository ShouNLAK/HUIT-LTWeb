@model List<LTWeb02_Bai04.Models.Product>

@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="carouselExampleControls" class="carousel slide mb-3" data-bs-ride="carousel">
  <div class="carousel-inner">
    <div class="carousel-item active">
      <img src="/Content/IMG/Carousel-1.jpg" class="d-block w-100" alt="Slide 1">
    </div>
    <div class="carousel-item">
      <img src="/Content/IMG/Carousel-2.jpg" class="d-block w-100" alt="Slide 2">
    </div>
  </div>
  <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true" style="background-color:black;"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true" style="background-color:black;"></span>
    <span class="visually-hidden">Next</span>
  </button>
</div>

<div class="p-2 mb-3 fw-bold" style="background-color: #f2f2f2; border: 1px solid #e0e0e0; font-size: 14px;">
    ỐNG ĐỒNG
</div>

<div class="row">
    @foreach(var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 rounded-0" style="border: 1px solid #e0e0e0;">
                <a href="/Home/Detail/@item.Id">
                    <img src="@item.ImageUrl" class="card-img-top p-2" alt="@item.Name" style="height: 150px; object-fit: contain;">
                </a>
                <div class="card-body p-3">
                    <h6 class="card-title fw-bold text-uppercase" style="font-size: 12px; margin-bottom: 10px;">@item.Name</h6>
                    <p class="card-text text-muted" style="font-size: 11px; font-style: italic; margin-bottom: 10px; min-height:35px;">@item.Description</p>
                    <p class="card-text fw-bold" style="color: #28a745; font-size: 12px; margin-bottom: 15px;">Giá: @item.Price</p>
                    <a href="/Home/Detail/@item.Id" class="btn btn-sm rounded-0 text-white" style="background-color: #0040a8; font-size: 11px; font-weight: bold; padding: 5px 15px;">&gt; Chi Tiết</a>
                </div>
            </div>
        </div>
    }
</div>