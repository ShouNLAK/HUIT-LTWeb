<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - LTWeb02_Bai04</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <style>
        body { font-size: 14px; background-color: #f5f5f5; font-family: Arial, sans-serif; }
        .site-container { max-width: 1000px; margin: 0 auto; background-color: #fff; box-shadow: 0 0 5px rgba(0,0,0,0.1); padding-bottom:0;}
        .header-top { padding: 10px 20px; }
        .header-logo img { max-width: 150px; }
        .header-title { color: #d92128; font-weight: bold; font-size: 24px; text-align: center; margin-bottom:5px;}
        .header-subtitle { color: #0056b3; font-size: 13px; text-align: center; font-weight: bold; }
        .header-contact { text-align: right; color: #0056b3; font-weight: bold; font-size: 16px; }
        
        .navbar-main { background-color: #fff; padding: 0; }
        .navbar-main .nav-link { color: #0056b3; font-weight: bold; text-transform: uppercase; font-size: 13px; padding: 10px 15px;}
        
        .navbar-blue { background-color: #0066b3; padding:0;}
        .navbar-blue .nav-link { color: #fff; text-transform: uppercase; font-size: 13px; font-weight: bold; padding: 10px 15px;}
        
        .sidebar-title { background-color: #0066b3; color: white; padding: 10px; font-weight: bold; text-transform: uppercase; margin-bottom: 0;}
        .sidebar-menu { border: 1px solid #ddd; border-top: none; padding: 0; list-style: none; margin-bottom: 15px;}
        .sidebar-menu > li > a { display: block; padding: 10px 15px; color: #333; text-decoration: none; border-bottom: 1px solid #eee; }
        .sidebar-menu > li > a:hover { background-color: #f9f9f9; color: #0066b3; }
        .sidebar-menu > li > a i { margin-right: 10px; color: #0066b3; }
        
        .submenu { list-style: none; padding-left: 20px; background-color: #fff; margin-bottom: 0;}
        .submenu li a { display: block; padding: 8px 10px; color: #333; text-decoration: none; font-size: 12px; border-bottom: 1px dotted #ccc;}
        .submenu li a:hover { color: #d92128; }
        .submenu li a i { margin-right: 5px; color:#d92128; font-size: 10px;}
        
        .support-box { background-color: #0066b3; color: white; padding: 15px; margin-top: 15px; }
        .support-box a { color: white; text-decoration: none; }
        
        .footer { background-color: #0066b3; color: white; padding: 20px; text-align: left; font-size: 12px; margin-top: 20px;}
    </style>
</head>
<body>
    <div class="site-container">
        <div class="row header-top align-items-center m-0">
            <div class="col-md-2 header-logo text-center">
                <img src="/Content/IMG/logo.jpg" alt="Logo" class="img-fluid rounded-circle">
            </div>
            <div class="col-md-7">
                <div class="header-title">NHÀ PHÂN PHỐI VẬT TƯ NGÀNH LẠNH GIÁ SỈ</div>
                <div class="header-subtitle">
                    CÔNG TY TNHH BLUE SEA | <span class="text-danger">MST: 0312980770</span><br />
                    CỬA HÀNG : 31 VÕ TRƯỜNG TOẢN, P.2, Q.BÌNH THẠNH, TP.HCM<br />
                    VATTUNGANHLANH.VN | <a href="#" style="color:#0056b3; text-decoration:underline;">0901 80 5000</a> | <a href="#" style="color:#0056b3; text-decoration:underline;">08 62 58 10 20</a>
                </div>
            </div>
            <div class="col-md-3 header-contact">
                <div class="d-flex align-items-center justify-content-end">
                    <i class="fas fa-phone-alt me-2" style="color:#f28500; font-size:30px;"></i>
                    <div style="text-align:left; line-height:1.2;">
                        <span style="color:#0056b3; font-size:16px;">0901 80 5000</span><br />
                        <span style="color:#0056b3; font-size:16px;">08 6258 1020</span>
                    </div>
                </div>
                <div class="mt-2 text-end">
                    <img src="/Content/IMG/Yahoo.png" alt="Yahoo" style="width:25px;" class="d-inline-block">
                    <img src="/Content/IMG/Skype.jpg" alt="Skype" style="width:50px;" class="d-inline-block ms-1">
                </div>
            </div>
        </div>
        
        <nav class="navbar navbar-expand-lg navbar-main justify-content-end pe-3">
            <ul class="navbar-nav flex-row">
                <li class="nav-item"><a class="nav-link" href="/Home/Index">TRANG CHỦ</a></li>
                <li class="nav-item"><a class="nav-link" href="#">GIỚI THIỆU</a></li>
                <li class="nav-item"><a class="nav-link" href="#">SẢN PHẨM</a></li>
                <li class="nav-item"><a class="nav-link" href="#">BẢNG GIÁ</a></li>
                <li class="nav-item"><a class="nav-link" href="#">TIN TỨC</a></li>
                <li class="nav-item"><a class="nav-link" href="#">LIÊN HỆ</a></li>
            </ul>
        </nav>
        
        <nav class="navbar navbar-expand-lg navbar-blue">
            <ul class="navbar-nav w-100 flex-row justify-content-around">
                <li class="nav-item"><a class="nav-link" href="#">ỐNG ĐỒNG</a></li>
                <li class="nav-item"><a class="nav-link" href="#">GAS LẠNH</a></li>
                <li class="nav-item"><a class="nav-link" href="#">DÂY ĐIỆN</a></li>
                <li class="nav-item"><a class="nav-link" href="#">ỐNG CÁCH NHIỆT</a></li>
                <li class="nav-item"><a class="nav-link" href="#">GEL CÁCH NHIỆT</a></li>
                <li class="nav-item"><a class="nav-link" href="#">TẤM CÁCH NHIỆT</a></li>
                <li class="nav-item"><a class="nav-link" href="#">VẬT TƯ KHÁC</a></li>
            </ul>
        </nav>

        <div class="row m-0 mt-3">
            <div class="col-md-3 px-2">
                <div class="sidebar-title">DANH MỤC</div>
                <ul class="sidebar-menu">
                    <li>
                        <a href="#menuOngDong" data-bs-toggle="collapse" role="button" aria-expanded="false"><i class="fas fa-dot-circle" style="font-size:10px"></i> ỐNG ĐỒNG</a>
                        <ul class="collapse submenu" id="menuOngDong">
                            <li><a href="#"><i class="fas fa-angle-right"></i> ỐNG ĐỒNG THÁI LAN</a></li>
                            <li><a href="#"><i class="fas fa-angle-right"></i> ỐNG ĐỒNG VIỆT NAM</a></li>
                            <li><a href="#"><i class="fas fa-angle-right"></i> ỐNG ĐỒNG TRUNG QUỐC</a></li>
                            <li><a href="#"><i class="fas fa-angle-right"></i> ỐNG ĐỒNG MALAYSIA</a></li>
                            <li><a href="#"><i class="fas fa-angle-right"></i> ỐNG ĐỒNG HÀN QUỐC</a></li>
                        </ul>
                    </li>
                    <li><a href="#"><i class="fas fa-dot-circle" style="font-size:10px"></i> GAS LẠNH</a></li>
                    <li>
                        <a href="#menuDayDien" data-bs-toggle="collapse" role="button" aria-expanded="true"><i class="fas fa-dot-circle" style="font-size:10px"></i> DÂY ĐIỆN</a>
                        <ul class="collapse submenu show" id="menuDayDien">
                            <li><a href="#"><i class="fas fa-angle-right"></i> DÂY ĐIỆN CADIVI</a></li>
                            <li><a href="#"><i class="fas fa-angle-right"></i> DÂY ĐIỆN DAPHACO</a></li>
                        </ul>
                    </li>
                    <li><a href="#"><i class="fas fa-dot-circle" style="font-size:10px"></i> TẤM CÁCH NHIỆT</a></li>
                </ul>

                <div class="support-box">
                    <h6 class="fw-bold mb-3 text-uppercase">HỖ TRỢ TRỰC TUYẾN</h6>
                    <div class="mb-3 d-flex align-items-center">
                        <span class="me-2">Mr. Trường</span> 
                        <img src="/Content/IMG/Yahoo.png" alt="Yahoo" style="width:20px;" class="me-1"> 
                        <img src="/Content/IMG/Skype.jpg" alt="Skype" style="width:45px;">
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="fas fa-mobile-alt fs-2 me-3"></i>
                        <div style="text-decoration:underline;">
                            <strong>0901 80 5000</strong><br />
                            <strong>08 6258 1020</strong>
                        </div>
                    </div>
                </div>
                
                <div class="sidebar-title mt-3 text-uppercase" style="font-size:13px;">FACEBOOK FANPAGE</div>
            </div>
            
            <div class="col-md-9 px-2">
                @RenderBody()
            </div>
        </div>

        <footer class="footer">
            <div class="row m-0">
                <div class="col-12 px-4">
                    <p class="mb-1 fw-bold" style="color: #f28500;">CÔNG TY TNHH BLUE SEA <span class="text-white fw-normal">| MST: 0312980770</span></p>
                    <p class="mb-1">CỬA HÀNG : 31 VÕ TRƯỜNG TOẢN, P.2, Q.BÌNH THẠNH, TP.HCM</p>
                    <p class="mb-1">TỔNG ĐÀI CSKH: 1900 72 75</p>
                    <p class="mb-0">FAX: 08 62 912 313</p>
                </div>
            </div>
        </footer>
    </div>
    
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
