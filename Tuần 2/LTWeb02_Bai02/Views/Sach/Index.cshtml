<style>
    .book-grid {
        display: grid;
        gap: 20px;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        max-width: 100%;
    }

    .book-item {
        background: #fff;
        border: 1px solid #ddd;
        padding: 15px;
        text-align: center;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .book-title {
        font-size: 16px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .book-price {
        color: #e74c3c;
        font-size: 14px;
        margin-bottom: 15px;
    }
</style>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
@model List<LTWeb02_Bai02.Models.Sach>
<body>
    <h1>Danh sách sách</h1>
    @{
        if (Model.Count != 0)
        {
            <div class="book-grid">
            @foreach (LTWeb02_Bai02.Models.Sach item in Model)
                {
                    <div class="book-item">
                        <img src="@item.AnhBia" style="max-width: 50%; max-height:50%" />
                        <p class="book-title">@item.TenSach</p>
                        <p class="book-price">@item.Gia</p>
                        <a href="/Sach/ChiTiet/@item.MaSach"><button type="submit" class="btn-primary">Xem chi tiết</button></a>
                    </div>
                }

            </div>
        }
    }
</body>