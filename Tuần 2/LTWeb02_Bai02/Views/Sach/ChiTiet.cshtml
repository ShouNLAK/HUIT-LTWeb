@model LTWeb02_Bai02.Models.Sach
<style>
    .book-detail {
        display: flex;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        max-width: 800px;
        margin: auto;
    }

    .book-cover {
        flex: 1;
        margin-right: 20px;
    }

    .book-cover img {
        max-width: 100%;
        border-radius: 6px;
    }

    .book-info {
        flex: 2;
    }

    .book-title {
        font-size: 22px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .book-author {
        font-size: 16px;
        color: #555;
        margin-bottom: 10px;
    }

    .book-price {
        font-size: 18px;
        color: #e74c3c;
        margin-bottom: 15px;
    }

    .book-description {
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 20px;
    }
</style>
<body>
    <div class="book-detail">
        <div class="book-cover">
            <img src="@Model.AnhBia" />
        </div>
        <div class="book-info">
            <h1 class="book-title">@Model.TenSach</h1>
            <p class="book-price">Giá : @Model.Gia</p>
            <p class="book-author">Tác giả : @Model.TacGia</p>
            <p class="book-description">Mô tả : @Model.MoTa</p>
        </div>
    </div>
</body>