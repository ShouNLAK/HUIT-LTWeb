
@{
    ViewBag.Title = "DangKy";
}

<div class="p-4" style="background-color: #6c757d;">
    <div class="card p-4 mx-auto" style="max-width: 500px; border-radius: 0;">

        <h4 class="mb-3 pb-2 border-bottom" style="color: #333;">
            <i class="bi bi-globe text-primary"></i> Đăng ký thành viên!
        </h4>

        <form>
            <div class="row mb-3 g-2">
                <div class="col-6">
                    <input type="text" class="form-control" placeholder="Họ">
                </div>
                <div class="col-6">
                    <input type="text" class="form-control" placeholder="Tên">
                </div>
            </div>

            <div class="mb-3">
                <input type="email" class="form-control" placeholder="Email">
            </div>
            <div class="mb-3">
                <input type="password" class="form-control" placeholder="Mật khẩu">
            </div>
            <div class="mb-3">
                <input type="password" class="form-control" placeholder="Nhập lại mật khẩu">
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Ngày sinh</label>
                <div class="row g-2">
                    <div class="col-4">
                        <select class="form-select">
                            <option selected>Ngày</option>
                            <option value="1">1</option>
                        </select>
                    </div>
                    <div class="col-4">
                        <select class="form-select">
                            <option selected>Tháng</option>
                            <option value="1">1</option>
                        </select>
                    </div>
                    <div class="col-4">
                        <select class="form-select">
                            <option selected>Năm</option>
                            <option value="2000">2000</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="mb-4">
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="genderOptions" id="radioNam" value="Nam">
                    <label class="form-check-label" for="radioNam">Nam</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="genderOptions" id="radioNu" value="Nữ">
                    <label class="form-check-label" for="radioNu">Nữ</label>
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-100">Đăng ký</button>
        </form>
    </div>
</div>