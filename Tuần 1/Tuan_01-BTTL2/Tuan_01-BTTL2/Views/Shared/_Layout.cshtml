<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
            integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
            crossorigin="anonymous"></script>
    <style>
        body {
            background-color: #f2f2f2;
            font-size: 13px;
        }

        .site {
            max-width: 1120px;
            margin: 18px auto;
            background-color: #fff;
            border: 1px solid #d9d9d9;
        }

        .top-head {
            border-bottom: 1px solid #e7e7e7;
            padding: 8px 16px;
        }

        .green-bg {
            background-color: gray;
        }

        .title-sec {
            font-size: 31px;
            font-weight: 700;
            color: #3c3c3c;
        }

        .mini-link {
            color: #2f89cf;
            text-decoration: none;
        }

            .mini-link:hover {
                text-decoration: underline;
            }

        .menu-title {
            font-weight: 700;
            color: #fff;
            background-color: #007bff;
            padding: 7px 12px;
        }

        .list-group-item {
            color: #4b8ec9;
            font-size: 14px;
        }

        .product-name {
            font-size: 14px;
            font-weight: 700;
            margin: 8px 0 2px;
        }
    </style>
</head>

<body>
    <div class="site">
        <div class="top-head row g-2 align-items-center">
            <img src="https://maichemientay.vn/wp-content/uploads/2023/10/banner-mai-xep-mien-tay-2.jpg" alt="Logo">
        </div>

        <nav class="navbar navbar-expand-lg navbar-light green-bg px-3">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navBttl8">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navBttl8">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link text-white" href="/Home/Index">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="/Home/DangKy">Đăng ký</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="/Home/DangNhap">Đăng nhập</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="/Home/Contact">Liên hệ</a></li>
                </ul>
                <form class="d-flex" role="search">
                    <input class="form-control form-control-sm me-2" type="search" placeholder="Search">
                    <button class="btn btn-outline-light btn-sm" type="submit">Search</button>
                </form>
            </div>
        </nav>
        <div class="row">
            <div class="col-12 col-lg-3 mt-3 mt-lg-0">
                <div class="menu-title">Danh mục sản phẩm</div>
                <div class="list-group rounded-0 mb-3">
                    <a href="#" class="list-group-item list-group-item-action">Máy xếp</a>
                    <a href="#" class="list-group-item list-group-item-action">Máy che</a>
                    <a href="#" class="list-group-item list-group-item-action">Máy vòm</a>
                    <a href="#" class="list-group-item list-group-item-action">Máy hiên di động</a>
                </div>
                <div class="menu-title">Hỗ trợ trực tuyến</div>
                <div class="menu-title">Thống kê truy cập</div>
                <div class="list-group rounded-0">
                    <div class="list-group rounded-0 mb-3">
                        <p>Số lượng truy cập : 87</p>
                        <p>Số người online : 10</p>
                        <p>Số lượng thành viên : 46</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-9 mt-3 mt-lg-0">
                @RenderBody()
            </div>
        </div>

    </div>
@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/bootstrap")
@RenderSection("scripts", required: false)
</body>
</html>
